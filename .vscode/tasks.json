{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Automated Environment Setup",
      "type": "shell",
      "windows": {
        "command": "if (-not (Test-Path '.venv')) { py -m venv .venv -ErrorAction SilentlyContinue; if (-not $?) { python -m venv .venv } }; .\\.venv\\Scripts\\pip install -r requirements.txt"
      },
      "osx": {
        "command": "python3 -m venv .venv && ./.venv/bin/pip install -r requirements.txt"
      },
      "linux": {
        "command": "python3 -m venv .venv && ./.venv/bin/pip install -r requirements.txt"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}